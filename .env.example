# Copy this file to ".env" and fill in your real Supabase project values.
# Find these under Supabase Dashboard -> Project Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is the PUBLIC "anon" key — safe to ship in frontend code
# because Row Level Security (see supabase/01_schema.sql and
# supabase/04_admin_security.sql) controls what it can actually read or
# write. NEVER put the "service_role" secret key here or anywhere in
# frontend code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Comma-separated list of the email address(es) allowed into /admin.
# Recommended once you know your admin's email — see src/lib/adminAuth.js
# for what this does and does not protect against.
VITE_ADMIN_EMAILS=owner@eliteestates.com
